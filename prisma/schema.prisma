// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  name       String
  password   String? // Nullable porque usuarios de OAuth no tendrán contraseña
  photoUrl   String? // URL de la foto de perfil para usuarios OAuth
  role       Role     @default(USER)
  provider   Provider @default(LOCAL)
  providerId String? // ID externo para usuarios de OAuth
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  BUSINESS
  USER
}

enum Provider {
  LOCAL
  GOOGLE
  APPLE
}
